# Copy to .env for local work. Never commit a filled-in .env — rule 2.2.
# These two are the ONLY variables allowed to reach the browser (CLAUDE.md rule 2.1).

# Supabase project URL — safe to expose.
VITE_SUPABASE_URL=

# Supabase anon/ publishable key — safe to expose, RLS is the real gate.
VITE_SUPABASE_ANON_KEY=

# NOT here, NOT in any VITE_* var: the service_role key. It belongs in the local
# .env for the Supabase CLI only and must never be read by the frontend.
