{
  "permissions": {
    "allow": [
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(bash .claude/skills/check-policy/scripts/check-policy.sh)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run dev:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase:*)",
      "Bash(npx vercel:*)",
      "Bash(vercel:*)",
      "Edit(./supabase/config.toml)",
      "Edit(./vercel.json)",
      "Edit(./.env)",
      "Edit(./.env.local)"
    ],
    "//deny": "Permission patterns have no exception syntax, so a broad .env.* deny would also block the committable .env.template template. These are the secret files we can name exactly; the PreToolUse hook is what enforces the general case (including .env.production) while still letting .env.template through. READING is denied unconditionally (rule 2.3 — .env holds the owner's PASSPHRASE); WRITING is gated by the hook against the unlock token from scripts/env-unlock.sh (rule 2.6).",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(./supabase/.temp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}