# Copy to .env and fill in. Never commit a filled-in .env — rule 2.2.
# `cp .env.template .env` then `scripts/env-setup.sh` to arm the write gate.
#
# The only two variables allowed to reach the browser (CLAUDE.md rule 2.1).
# The publishable key (`sb_publishable_...`) replaces the legacy `anon` key,
# which Supabase stops issuing to new projects in late 2026. It carries the
# same LOW privilege: Row Level Security is the real gate, not the key.

# Supabase project URL — safe to expose.
#   local Supabase:  http://127.0.0.1:54321
#   hosted project:  https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key — safe to expose.
#   local: a fixed public constant printed by `supabase start` (issuer
#          `supabase-demo`); identical on every developer's machine.
#   hosted: the owner's `sb_publishable_...` from Dashboard > API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=

# NOT here, NOT in any VITE_* var: the secret key (`sb_secret_...`, formerly
# `service_role`). It bypasses RLS entirely. Browser use returns HTTP 401.
# It belongs in the owner's Vercel env or their own password manager, never
# in this repo.

# ---------------------------------------------------------------------------
# Write gate (see README "Write gate for .env")
# ---------------------------------------------------------------------------
# Your own passphrase, chosen by you, never stored in git. An agent never reads
# it: rule 2.3 forbids reading .env, and this file is where it lives.
# scripts/env-unlock.sh compares what you TYPE against this line and writes a
# short-lived token that the PreToolUse hook checks.
#
# It is deliberately NOT in the README. A passphrase in a public file is one
# the agent can simply read, then hash and forge a token with — the gate would
# stop a careless agent and no deliberate one.
PASSPHRASE=
